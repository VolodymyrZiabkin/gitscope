# Fine-grained personal access token with no extra permissions (public data only).
# Leave empty to run on recorded fixtures — no GitHub access needed.
GITHUB_TOKEN=

# Shared secret with the web app: lets the API trust the x-client-ip header for rate limiting.
# Required in production, at least 32 characters (e.g. `openssl rand -hex 32`).
INTERNAL_API_KEY=

PORT=4000
LOG_LEVEL=info
# Requests per minute per client IP.
RATE_LIMIT_MAX=60
# Number of reverse proxies in front of the API (Render: 1). 0 = use the socket address.
TRUST_PROXY=0
