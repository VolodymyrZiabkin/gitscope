    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@gitscope/shared": "workspace:*",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
