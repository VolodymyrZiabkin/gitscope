# Where the Fastify API listens (server-side only — the browser goes through the /api proxy route).
API_URL=http://localhost:4000
# Same value as INTERNAL_API_KEY of the API: lets it rate-limit by the real client IP.
INTERNAL_API_KEY=
# Public origin for absolute URLs in metadata and OG images. On Vercel the production URL is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
